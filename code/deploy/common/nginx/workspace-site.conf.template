# ── 工作台站点（compose 里的 nginx 容器用）—— SYS-STAGING-001 ──────────────────
# 渲染后的实际文件：code/deploy/test/nginx/workspace.conf
#   → 测试机上 /opt/lqg-test/nginx/workspace.conf
#   → 挂进 nginx 容器 /etc/nginx/conf.d/default.conf
#
# 分层（doc/waves/ops/tianda-test-env.md §6.2）：
#   浏览器/小程序 ──HTTPS 443──> 宿主 nginx（宝塔，songjian.tianda.studio）
#                                  └── 全量 proxy_pass ──> 127.0.0.1:${LQG_WEB_PORT}（本容器）
#   本容器：静态 plus-ui dist + /prod-api 反代 + 小程序/api.sh 直连的根路径接口反代
#   ★ 宿主 80/443 归宝塔，容器一律**不许**抢；所以 HTTPS 在宿主层终止（见 baota-site.conf.template），
#     本容器只监听 80、且只发布到宿主 127.0.0.1。
#
# 模板变量（由 deploy.sh 用 envsubst 渲染）：
#   ${LQG_BACKEND_UPSTREAM}  compose 网络里后端服务名:端口，默认 backend:8080
server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # 上传/导出走同一个后端；与宿主 nginx 的值保持一致
    client_max_body_size 50m;

    # ── 1) 网页工作台的 API：plus-ui 的 VITE_APP_BASE_API=/prod-api ─────────────
    #    带 ^~ 前缀，避免被下面的正则 location 抢走。proxy_pass 末尾的 `/` 会**剥掉** /prod-api 前缀。
    location ^~ /prod-api/ {
        proxy_pass http://${LQG_BACKEND_UPSTREAM}/;
        include /etc/nginx/conf.d/lqg-proxy-headers.inc;
    }

    # ── 2) 小程序 / doc/verify/api.sh 直连的根路径接口（**不剥前缀**）────────────
    #    小程序 env/.env.test 的 VITE_SERVER_BASEURL=https://<域名>，请求路径是 /auth/login、/mp/...；
    #    api.sh 请求 /auth/login、/lqg/sys/ping、/mp/ext/... —— 两边都不带 /prod-api。
    #    proxy_pass 不带 URI 部分 → 原样透传路径。
    location ~ ^/(auth|lqg|mp|system|monitor|resource|tool|workflow|actuator|snail-job)/ {
        proxy_pass http://${LQG_BACKEND_UPSTREAM};
        include /etc/nginx/conf.d/lqg-proxy-headers.inc;
    }

    # ── 3) 工作台静态资源 + SPA history 回退 ────────────────────────────────────
    #    缺 try_files 这条，深链直接 404（首页 200 会骗人，栈坑手册 §7）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存（plus-ui 的产物带 hash，长缓存安全）
    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|woff2?|ttf|eot|ico)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }
}
