# SYS-STAGING-001 · 测试环境变量模板
#
#   cp .env.example .env && chmod 600 .env
#   bash deploy.sh all
#
# ★ `.env` 里有口令，**绝不进 git**（根 .gitignore 的 `code/deploy/**/.env` 覆盖它，
#   accept 第 2 条还会 `git ls-files` 复核一次）。仓库里只留这份 .env.example。
# ★ 这份文件里的口令只是**占位**：真口令 deploy.sh 会用 openssl rand 生成一次并写进 .env，
#   然后把同一份 .env scp 到测试机（chmod 600）。要看口令就在测试机 `cat /opt/lqg-test/.env`。
#
# 端口纪律：这台测试机上还跑着 guzi 与 tianda 两个别的项目的容器，宿主
# 80/443/888/8881/23127/8080/8081/3306/3307/6380/3000 全被占着 —— 本项目一个都不用。
# postgres/redis/minio/backend/nginx 一律只绑 127.0.0.1（accept 第 2 条查这个）。

# ── 部署目标 ────────────────────────────────────────────────────────────────
# 测试机（Kevin 的阿里云 ECS，AccountId 1826406494972500；SSH root@<host> 免密已配）
LQG_TEST_HOST=118.178.109.11
# 测试机 ECS 实例 ID（accept[2] 的等价取证要从实例现查安全组 ID，见 deploy.sh prove-ports）
LQG_ECS_ID=i-bp14wbcfphboybx9idug
LQG_TEST_DOMAIN=songjian.tianda.studio
# 部署目录：**不要**放 /www/wwwroot/<域名> 下（宝塔 AddSite 会把站根 chown 成 www，
# root 在那儿跑 docker/git 会撞 dirty-ownership；本站的静态产物由 compose 的 nginx 容器提供）
LQG_DEPLOY_DIR=/opt/lqg-test

# ── 宿主环回端口（避开别人的占用）────────────────────────────────────────────
LQG_DB_PORT=15432
LQG_REDIS_PORT=16379
LQG_MINIO_PORT=19000
LQG_MINIO_CONSOLE_PORT=19001
LQG_API_PORT=8082
LQG_WEB_PORT=8083

# ── PostgreSQL（库名必须含 test：reseed.sh 的护栏）──────────────────────────
LQG_DB_NAME=lqg_test
LQG_DB_USER=lqg
LQG_DB_PASSWORD=change-me-db

# ── Redis（必须设口令：Redisson 配了口令就发 AUTH，服务端没口令直接报错）──────
LQG_REDIS_PASSWORD=change-me-redis

# ── MinIO（桶保持私有；前端拿后端签发的短时签名链接）────────────────────────
LQG_MINIO_USER=minioadmin
LQG_MINIO_PASSWORD=change-me-minio
LQG_MINIO_BUCKET=lqg-test

# ── 反 stale：注入 /lqg/sys/ping 的 buildCommit ─────────────────────────────
# deploy.sh 每次都会用 `git rev-parse --short=12 HEAD` 覆盖它；手填没用，留个说明。
LQG_BUILD_COMMIT=000000000000

# ── 微信小程序（甲方主体 appid 未提供 → 留空；体验版登录走 mock 调试入口）──────
# 真实 appid / secret 由 Kevin 提供后填这里，**不进仓库**
LQG_WX_APPID=
LQG_WX_SECRET=

# ── 管理员口令加固（2026-09-28）──────────────────────────────────────────────
# seed 里 lqgadmin 的口令是固定默认值，而本环境公网可达；remote/03-reseed.sh 第 7 步
# 每次灌完 seed 都幂等地把它强制成下面的值（不设则明确告警「仍是默认口令」）。
# ★ 这份是模板，**真口令只写进 .env 与本地 doc/verify/verify.test.env**，两者必须一致。
LQG_ADMIN_USER=lqgadmin
LQG_ADMIN_PASSWORD=
# seed 里的默认口令，只在「从默认改到强」那一步用一次
LQG_SEED_ADMIN_PASSWORD=admin123

# ── mock 登录开关（台账 #346）────────────────────────────────────────────────
# true  = application-test.yml 的缺省行为：小程序可 mock 登录（拿到 appid 前靠它试用）。
# false = 关掉 mock（真实微信登录生效）。**公网环境下这是唯一的止血开关**：
#   实测 mock token 能读+写工作台业务数据，拿到 appid+secret 后应置 false 再 up。
LQG_MOCK_LOGIN=true

# ── 口令加固需要：工作台账号登录的 client（第 7 步靠它登录改口令）────────────────
# 取值 = doc/verify/verify.test.env 的 LQG_CLIENT_PC（sys_client 里的 pc 行，与部署环境无关）。
# ★ 漏配它 → 03-reseed.sh 第 7 步会明确告警并跳过，口令退回 seed 默认值（2026-09-28 实测踩过）。
LQG_CLIENT_PC=e5cd7e4891bf95d1d19206ce24a7b32e

# ── 小程序体验版上传（2026-09-28）──────────────────────────────────────────────
# 代码上传私钥的本机绝对路径（**不进仓库**）。上传在测试机上做（固定 IP 可加进微信白名单）。
LQG_MINIPROGRAM_KEY=
