# SYS-BASE-001 · 本地开发环境变量模板（照这份建 .env；.env 已在 .gitignore 里，不进仓库）
#
# 端口纪律：8080 / 5432 / 6379 留给 Kevin 本机日常服务，开发环境一律用 5433 / 6380 / 9002 / 9003 / 8081。
# 口令只用于本地开发与测试；生产口令走各自环境的环境变量、不进仓库（SYS-PROD-001）。
# Redis 必须设口令：若依 Redisson 配了口令就发 AUTH，服务端没口令会直接报错。

# ── PostgreSQL（compose 服务 postgres，宿主端口 → 容器 5432）──
LQG_DB_NAME=lqg_dev
LQG_DB_USER=lqg
LQG_DB_PASSWORD=lqg_dev_pwd
LQG_DB_PORT=5433

# ── Redis（compose 服务 redis，宿主端口 → 容器 6379；口令必须与服务端一致）──
LQG_REDIS_PORT=6380
LQG_REDIS_PASSWORD=lqg_dev_redis_pwd

# ── MinIO（compose 服务 minio，宿主 9002 api / 9003 console；bucket 建出来就是私有）──
LQG_MINIO_PORT=9002
LQG_MINIO_CONSOLE_PORT=9003
LQG_MINIO_USER=minioadmin
LQG_MINIO_PASSWORD=minioadmin
LQG_MINIO_BUCKET=lqg

# ── 后端 ──
LQG_API_PORT=8081
