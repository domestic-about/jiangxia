# ── SYS-PROD-001 · 生产环境变量模板 ────────────────────────────────────────────────
#
#   cd code/deploy/prod
#   cp .env.example .env && chmod 600 .env      # 填真口令 / 域名 / AK
#   bash deploy.sh all
#
# ★ `.env` 里有生产口令与 AK，**绝不进 git**（根 .gitignore 的 `code/deploy/**/.env` 覆盖它，
#   accept 2 的第 5 段还会 `git ls-files` 复核一次）。仓库里只留这份 .env.example。
# ★ 这份文件里的值是**占位**。除域名 / 主机 / AK 这些只有 owner 知道的量之外，
#   其余口令与密钥由 `bash gen-secrets.sh` 现生成一次并写回 .env（幂等：只填空着 / change-me 的键，
#   已有的真值一个不动）。deploy.sh 本身不生成口令，缺了会在 preflight / load_env 里直接报错。
# ★ 部署后 .env 会在服务器上留一份（${LQG_DATA_DIR}/.env，600）：容器重启 / 手工排查要用，
#   本地这份是**投放源**。两份要一致，改了口令要两边都改（部署手册 §5）。
#
# ⚠️ 下面 4 个值 **owner 未提供、当前填不了**（见 doc/handover/d8-blockers.json 的 B2）：
#   LQG_PROD_HOST / LQG_PROD_DOMAIN / LQG_ICP_LICENSE / LQG_OSS_*。本票不猜具体值。

# ── 部署目标（★ 全是 owner 待填：B2 生产主机与域名与 ICP）──────────────────────────
# 生产服务器公网 IP 或内网可达地址。**不要填 118.178.109.11** —— 那是测试机
# （上面跑 test 环境，songjian.tianda.studio，profile=test；见 doc/handover/d8-blockers.json 的 B2）。
LQG_PROD_HOST=
# SSH 目标（verify.prod.env 的 LQG_PROD_SSH 与它同源），形如 root@<生产主机>
LQG_PROD_SSH=
# 生产域名（已 ICP 备案的那个）。**必须是域名**：Let's Encrypt 不给裸 IP 签证书。
LQG_PROD_DOMAIN=
# ICP 备案号（上线后要放在页面页脚；先留空，ICP 下来后填）
LQG_ICP_LICENSE=
# 生产服务器 SSH 端口（默认 22；改过端口就填）
LQG_PROD_SSH_PORT=22

# ── 部署目录与数据盘（数据卷落数据盘；见部署手册 §1）──────────────────────────────
# 买机器时把数据盘挂到 /opt/lqg（或改这里）。postgres 的数据是 bind mount 到这里，
# 不是 docker named volume —— named volume 在 /var/lib/docker（系统盘）上。
LQG_DATA_DIR=/opt/lqg

# ── 宿主端口（生产只有 nginx 用 80/443，其余服务一个宿主端口都不映射）──────────────
# ★ 这两个是给 deploy.sh 做「端口占用 / 防火墙」自检用的，不是 compose 的映射值。
#   ⚠️ 不要在这里加 DB / Redis / Gotenberg / backend 的端口：加了就等于给
#   「本来不该开在公网的端口」留了口子（accept 2 第 1、2 段查的正是这个）。
LQG_HTTP_PORT=80
LQG_HTTPS_PORT=443

# ── PostgreSQL（库名必须**不含 test**：reseed.sh 的护栏靠这个字符串挡住误灌生产）────
LQG_DB_NAME=lqg
LQG_DB_USER=lqg
# deploy.sh 首次运行会替换成 openssl rand 生成的值
LQG_DB_PASSWORD=change-me-db

# ── Redis（必须设口令：Redisson 配了口令就发 AUTH，服务端没口令后端直接起不来）─────
LQG_REDIS_PASSWORD=change-me-redis

# ── 字段加密口令（ADR-0006）★ 与测试的 LqgTestAesKey#01 **必须不同** ────────────────
# 三列加密（供体姓名 / 住院号 / 患者编号）的 AES 口令。丢了 = 这三列永远读不出来。
# 上线当天另存一份给 Kevin，并记入交接单（部署手册 §8）。
LQG_ENCRYPT_PASSWORD=change-me-encrypt

# ── 登录令牌签名密钥（V13）★ 不许是若依默认的 abcdefghijklmnopqrstuvwxyz ─────────────
# Sa-Token 的 JWT 签名密钥：拿到它就能验签（也能签）登录 token。≥ 32 个字符；gen-secrets.sh 生成 64 位十六进制。
# 换它 = 所有已登录用户的 token 失效（要重新登录），不丢数据。
LQG_JWT_SECRET=

# ── 接口加解密（V14）：两对 RSA-2048，前后端各拿一半 ★ 不许用若依公开的 512 位那对 ───────────
# 格式：私钥 = PKCS#8 DER 的 Base64、公钥 = X.509 DER 的 Base64，单行、不带 PEM 头尾。gen-secrets.sh 成对生成。
#   请求：工作台用 VITE_APP_RSA_PUBLIC_KEY 加密 → 后端用 LQG_API_REQUEST_PRIVATE_KEY 解密
#   响应：后端用 LQG_API_RESPONSE_PUBLIC_KEY 加密 → 工作台用 VITE_APP_RSA_PRIVATE_KEY 解密
# 后端两个由 compose 注入 backend 容器；前端两个只在本机 `deploy.sh artifacts` 构建工作台时用
# （Vite 从环境变量读，code/plus-ui/.env.production 里不再写死）。deploy.sh preflight 会核它们是否成对。
LQG_API_REQUEST_PRIVATE_KEY=
LQG_API_RESPONSE_PUBLIC_KEY=
VITE_APP_RSA_PUBLIC_KEY=
VITE_APP_RSA_PRIVATE_KEY=

# ── actuator 访问口令（可选）─────────────────────────────────────────────────────
# 不填 = 后端每次启动随机一个（等于谁都进不去 /actuator，生产本来也只开 health / info 且 nginx 不转发）。
# LQG_ACTUATOR_USER=
# LQG_ACTUATOR_PASSWORD=

# ── 微信小程序（甲方主体，SYS-RELEASE-001 到位后填）───────────────────────────────
# 生产**拒绝** mock 登录（ADR-0008：prod 下 mock 被打开则应用拒绝启动），所以这两个值
# 不到位 = 小程序线上登录不可用。到位前留空即可，后端照常起、工作台照常用。
LQG_WX_APPID=
LQG_WX_SECRET=

# ── 阿里云 OSS：**私有读写**桶 + 只授这一个桶的 RAM 子账号（B1）────────────────────
# ★ access_key / secret 只进这份 .env 与服务端的 sys_oss_config（由 oss-init.sql 写）。
#   **不进仓库** —— accept 2 第 6 段就是 `git grep 'LTAI[0-9A-Za-z]{12,}'`。
# ★ 子账号最小权限：只授这个 bucket（lqg-prod-*），不给 OSS 全权、不给 RAM 管理权。
LQG_OSS_BUCKET=
LQG_OSS_ENDPOINT=
# OSS 的 region（形如 cn-hangzhou；bucket 在哪个地域就填哪个）
LQG_OSS_REGION=
LQG_OSS_ACCESS_KEY_ID=
LQG_OSS_ACCESS_KEY_SECRET=
# 业务对象前缀（ADR-0002 的备份走 backup/，业务文件走这里；两个前缀分开）
LQG_OSS_PREFIX=lqg/

# ── 告警（飞书机器人 webhook）────────────────────────────────────────────────────
# healthcheck.sh 往这里发告警；先留空也能跑（脚本会退化成打日志 + 非零退出）。
# 取法：飞书群 → 设置 → 群机器人 → 添加「自定义机器人」→ 复制 webhook 地址。
LQG_ALERT_WEBHOOK=

# ── 反 stale：注入 /lqg/sys/ping 的 buildCommit ──────────────────────────────────
# deploy.sh 每次都会用 `git rev-parse --short=7 HEAD` 覆盖它（accept 1 第 2 段断的就是这个值）；
# 手填没用，留个说明。★ 回滚时把它改回上一个提交号即可（部署手册 §6）。
LQG_BUILD_COMMIT=0000000

# ── 证书（acme.sh 自动续期）──────────────────────────────────────────────────────
# 签发 / 续期用的邮箱（Let's Encrypt 到期提醒发这里）
LQG_CERT_EMAIL=
# 证书机构：letsencrypt（默认）或 zerossl；国内机器连不上 LE 时可换 buypass
LQG_CERT_CA=letsencrypt
