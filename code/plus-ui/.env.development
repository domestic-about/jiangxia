# 页面标题（SYS-WEB-001：品牌 = 类器官样本管理）
VITE_APP_TITLE = 类器官样本管理
VITE_APP_LOGO_TITLE = 类器官样本管理

# 开发环境配置
VITE_APP_ENV = 'development'

# 开发环境
VITE_APP_BASE_API = '/dev-api'
# 本地后端（SYS-BASE-001 起的 dev 后端在 8081；8080 / 5432 / 6379 留给本机日常服务）
VITE_APP_PROXY_TARGET = 'http://127.0.0.1:8081'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITOR_ADMIN = 'http://localhost:9090/admin/applications'

# SnailJob 控制台地址
VITE_APP_SNAILJOB_ADMIN = 'http://localhost:8800/snail-job'

# 开发端口（80 要 root；8080 留给本机日常服务）
VITE_APP_PORT = 8082

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
# 后端本地起法带 --api-decrypt.enabled=false（见 .tmp/run-backend.sh），这里必须一起关，
# 否则前端加密了请求体、后端不解密 → 登录一律失败。
VITE_APP_ENCRYPT = false
# 接口加密传输 RSA 公钥与后端解密私钥对应 如更换需前后端一同更换
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ=='
# 接口响应解密 RSA 私钥与后端加密公钥对应 如更换需前后端一同更换
VITE_APP_RSA_PRIVATE_KEY = ''

# 客户端id
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'

# websocket 开关 默认使用sse推送
VITE_APP_WEBSOCKET = false

# sse 开关
VITE_APP_SSE = true
