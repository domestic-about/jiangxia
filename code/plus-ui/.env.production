# 页面标题（SYS-WEB-001：品牌 = 类器官样本管理）
VITE_APP_TITLE = 类器官样本管理
VITE_APP_LOGO_TITLE = 类器官样本管理

# 生产环境配置
VITE_APP_ENV = 'production'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITOR_ADMIN = '/admin/applications'

# SnailJob 控制台地址
VITE_APP_SNAILJOB_ADMIN = '/snail-job'

# 生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

VITE_APP_PORT = 80

# 接口加密功能开关(如需关闭 后端也必须对应关闭)
VITE_APP_ENCRYPT = true
# ★ V14（独立验收 2026-09-23）：接口加密的两把 RSA 密钥**不再写死在这里**（若依那对 512 位密钥是公开的）。
#   构建时从环境变量注入 —— Vite 不覆盖已经存在的进程环境变量：
#     VITE_APP_RSA_PUBLIC_KEY   请求加密公钥，对应后端 LQG_API_REQUEST_PRIVATE_KEY
#     VITE_APP_RSA_PRIVATE_KEY  响应解密私钥，对应后端 LQG_API_RESPONSE_PUBLIC_KEY
#   正式部署走 code/deploy/prod/deploy.sh：它先从 .env 读这两个值、核对与后端那两把成对，再 pnpm build:prod。
#   没注入就 build:prod 的产物接口加密没有密钥（登录必失败，不会静默放行）；vite.config.ts 会在构建时打醒目的警告，
#   注入的若是若依公开的默认密钥则直接构建失败。

# 客户端id
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'

# websocket 开关 默认使用sse推送
VITE_APP_WEBSOCKET = false

# sse 开关
VITE_APP_SSE = true
