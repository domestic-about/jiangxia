# 页面标题（SYS-WEB-001：品牌 = 类器官样本管理）
VITE_APP_TITLE = 类器官样本管理
VITE_APP_LOGO_TITLE = 类器官样本管理

# ── SYS-STAGING-001 · 测试环境构建（pnpm build:test）──────────────────────────
# 与 .env.production 的差异只有一处：VITE_APP_ENCRYPT=false。
#
# 为什么必须关：application-test.yml 里 api-decrypt.enabled=false（票面 §2 要求「api 加解密关」），
# 因为 doc/verify/api.sh 是裸 curl（不带 encrypt-key 头、不做 RSA/AES），后端开着加解密它一律登录失败，
# 而 SYS-STAGING-001 的 accept 第 1 条整条都建立在这个执行器上。
# 前端如果还开着VITE_APP_ENCRYPT（.env.production 是 true），登录请求体会被 AES 加密而后端不解密
# → 工作台登录一律失败。与 .env.development 的口径一致（那边也是 false，注释写着同一个理由）。
# 生产（SYS-PROD-001）不受影响：它走 .env.production，加解密两边都开着。
VITE_APP_ENV = 'test'

# 应用访问路径 例如使用前缀 /admin/
VITE_APP_CONTEXT_PATH = '/'

# 监控地址
VITE_APP_MONITOR_ADMIN = '/admin/applications'

# SnailJob 控制台地址
VITE_APP_SNAILJOB_ADMIN = '/snail-job'

# 测试环境：相对前缀，由站点 nginx 反代到本机后端（宿主 nginx → compose nginx → backend 容器）
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

VITE_APP_PORT = 80

# 接口加密功能开关：**测试环境必须与后端 api-decrypt.enabled=false 一致**（见开头注释）
VITE_APP_ENCRYPT = false
# 接口加密传输 RSA 公钥与后端解密私钥对应（加密关着，这两把key只是留着，prod 用）
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAKoR8mX0rGKLqzcWmOzbfj64K8ZIgOdHnzkXSOVOZbFu/TJhZ7rFAN+eaGkl3C4buccQd/EjEsj9ir7ijT7h96MCAwEAAQ=='
VITE_APP_RSA_PRIVATE_KEY = ''

# 客户端id
VITE_APP_CLIENT_ID = 'e5cd7e4891bf95d1d19206ce24a7b32e'

# websocket 开关 默认使用sse推送
VITE_APP_WEBSOCKET = false

# sse 开关
VITE_APP_SSE = true
