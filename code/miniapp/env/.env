# 公共环境变量（所有 mode 加载，被 .env.<mode> 覆盖）
#
# vite mode 规则：
#   pnpm dev:mp-weixin / pnpm dev:h5  → mode=development
#   pnpm build:mp-weixin / build:h5   → mode=production

VITE_APP_TITLE = '类器官送检'
VITE_APP_PORT = 9100

VITE_UNI_APPID = '__UNI__LQG0001'
# 甲方小程序 appid 未提供（SYS-RELEASE-001），先用占位；真机联调时替换
VITE_WX_APPID = 'wxf7933ab70657e598'

VITE_APP_PUBLIC_BASE = /

# 后端地址：本地 dev 下小程序直连（不走小程序代理）；真机 / 开发者工具直连的地址
# 必须是 LAN IP，换 WiFi 会变，见栈包 gotchas §6.6。正式环境地址在 SYS-RELEASE-001 里配。
VITE_SERVER_BASEURL = 'http://127.0.0.1:8081'

# H5 dev server 代理（仅 H5 生效，用来绕开浏览器跨域）
VITE_APP_PROXY_ENABLE = true
VITE_APP_PROXY_PREFIX = '/lqg-api'

# 小程序 client_id：md5('mp' || client_secret)，与 sys_client.client_key='mp' 那行对齐
# （取号依据见 doc/waves/reports/AUTH-LOGIN-001.md §1）
VITE_APP_CLIENT_ID = '22b2aecd0710671691ec1c07f2542b9d'

# 单租户（ADR-0001 多租户关闭），若依登录仍要 tenantId
VITE_APP_TENANT_ID = '000000'

# 原生插件资源复制开关（app 平台才用得到）
VITE_COPY_NATIVE_RES_ENABLE = false
