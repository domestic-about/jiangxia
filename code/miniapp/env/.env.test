NODE_ENV = 'production'
# 生产构建去 console / debugger
VITE_DELETE_CONSOLE = true

# ── SYS-STAGING-001 · 测试环境（体验版）构建 ─────────────────────────────────
# 用法：pnpm upload:mp --mode=test   （= uni build -p mp-weixin --mode test + miniprogram-ci 上传）
#
# 与 env/.env（公共）的差异：
#   1. VITE_SERVER_BASEURL 指向测试机域名 —— **必须 https**：小程序体验版的 request 合法域名
#      只认 https，且要在小程序后台「开发设置 → 服务器域名」里登记（见报告里的「需要 Kevin 做」）。
#      这台机器上的测试环境由宿主宝塔 nginx 终止 TLS（songjian.tianda.studio）。
#   2. VITE_MOCK_LOGIN=1 —— 体验版要能登进 seed 账号给甲方看真数据：
#      甲方主体的 appid 还没拿到（SYS-RELEASE-001），真实微信登录换不出 seed 里绑定的 openid；
#      ADR-0008 明确允许 test profile 开 mock 登录，后端 application-test.yml 也是 mock-login=true。
#      生产构建（env/.env.production）里**没有**这个变量 → 调试面板与 mock:ext 字面量被摇掉
#      （SYS-MP-001 accept 第 1 条 grep dist/build/mp-weixin 不许出现 mock:ext）。
VITE_SERVER_BASEURL = 'https://songjian.tianda.studio'
VITE_MOCK_LOGIN = '1'
