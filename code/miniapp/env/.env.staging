NODE_ENV = 'production'
# 生产构建去 console / debugger
VITE_DELETE_CONSOLE = true

# ── 测试环境（staging）构建 · V07 ─────────────────────────────────────────────
# 用法：pnpm upload:mp --mode=staging        （= 本地构建 + miniprogram-ci 上传，默认 robot 2）
#
# 与 env/.env.test 的差别：这里是**给甲方试用的体验版**口径 ——
#   · 接口指测试环境域名（必须 https，已在小程序后台登记为 request 合法域名）；
#   · **不开**测试身份登录（VITE_MOCK_LOGIN 不写 = 关）：体验版走真实微信登录，
#     公网测试环境上不留「不用微信就能冒充任意身份」的入口（独立验收 V08）。
#   需要 seed 身份演示时仍用 --mode=test（本地开发者工具里用，不发给甲方）。
VITE_SERVER_BASEURL = 'https://songjian.tianda.studio'
