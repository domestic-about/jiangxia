NODE_ENV = 'production'
# 生产构建去 console / debugger
VITE_DELETE_CONSOLE = true

# ── 正式环境接口地址（V07）──────────────────────────────────────────────────
# 生产域名 ICP 备案、证书就绪后填在这里：必须 https、不带结尾斜杠，例如 https://<生产域名>。
# 也可以在构建 / 上传时用同名环境变量注入（进程环境变量优先于本文件）：
#   VITE_SERVER_BASEURL=https://<生产域名> LQG_WX_APPID=wx... LQG_WX_PRIVATE_KEY=... pnpm upload:mp --mode=production
# ★ 这里**必须显式写一行**：不写就会继承 env/.env 的 http://127.0.0.1:8081，正式包里带着本机回环地址。
#   现在留空（域名未定）：普通的 pnpm build:mp-weixin 照常能构建，但 scripts/upload-mp.mjs 在
#   production 模式上传前会拦下（空值 / 非 https / 回环或内网地址 / 测试域名 / 占位 appid / mock 登录开着）。
VITE_SERVER_BASEURL = ''

# 测试身份登录入口：生产构建恒关（vite.config.ts 的 __LQG_MOCK_LOGIN__ 只在 development / test 模式可能为真），
# 这里显式写 0 只是把口径写在明处（SYS-RELEASE-001）。
VITE_MOCK_LOGIN = '0'
