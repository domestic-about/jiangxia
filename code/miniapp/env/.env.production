NODE_ENV = 'production'
# 生产构建去 console / debugger
VITE_DELETE_CONSOLE = true

# ── 正式环境接口地址（V07）──────────────────────────────────────────────────
# 必须 https、不带结尾斜杠；生产 nginx 在域名根上直接路由 /auth、/mp、/lqg（code/deploy/prod/nginx/app-locations.inc）。
# 还要在「微信公众平台 → 开发管理 → 服务器域名 → request 合法域名」里登记同一个域名。
# ★ 这里**必须显式写一行**：不写就会继承 env/.env 的 http://127.0.0.1:8081，正式包里带着本机回环地址。
#   scripts/upload-mp.mjs 在 production 模式上传前还会拦一遍（非 https / 回环或内网地址 / 测试域名 / mock 登录开着）。
VITE_SERVER_BASEURL = 'https://hborganoidshub.com'

# 测试身份登录入口：生产构建恒关（vite.config.ts 的 __LQG_MOCK_LOGIN__ 只在 development / test 模式可能为真），
# 这里显式写 0 只是把口径写在明处（SYS-RELEASE-001）。
VITE_MOCK_LOGIN = '0'
