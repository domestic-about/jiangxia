   "body": "import request from \"/src/utils/request.ts\";\nexport function renderDoc(sampleId, docKind, audience) {\n  return request({\n    url: `/lqg/doc/${sampleId}/${docKind}/render`,\n    method: \"post\",\n    params: { audience }\n  });\n}\nexport function getDocPages(sampleId, docKind, audience) {\n  return request({\n    url: `/lqg/doc/${sampleId}/${docKind}/pages`,\n    method: \"get\",\n    params: { audience }\n  });\n}\nexport function getDocDownload(sampleId, docKind, format, audience) {\n  return request({\n    url: `/lqg/doc/${sampleId}/${docKind}/download`,\n    method: \"get\",\n    params: { format, audience }\n  });\n}\nexport function publishQcDoc(sampleId, docType) {\n  return request({\n    url: `/lqg/qc/${sampleId}/${docType}/publish`,\n    method: \"post\"\n  });\n}\nexport function unpublishQcDoc(sampleId, docType) {\n  return request({\n    url: `/lqg/qc/${sampleId}/${docType}/unpublish`,\n    method: \"post\"\n  }"
  },
