# ── SYS-PROD-001 · 生产验收环境变量模板 ────────────────────────────────────────────
#
#   cp doc/verify/verify.prod.env.example doc/verify/verify.prod.env   # 真文件不进 git
#   export LQG_VERIFY_ENV_FILE=doc/verify/verify.prod.env
#   bash doc/verify/api.sh --as admin GET /lqg/sys/ping
#
# ★★ 这份模板存在的意义：**列出 acc1 / acc2 需要的全部键，并说明每个键去哪取**。
#   它**不含任何真值** —— 生产域名、主机、管理员口令、OSS 探针地址都只有 owner 能提供
#   （见 doc/handover/d8-blockers.json 的 B1/B2）。本票不猜、不填、不造。
#
# ★★ 当前状态：**这些断言一条都没跑过**，因为真生产环境不存在。
#   现在阿里云那台 ECS（118.178.109.11）上跑的是 **test** 环境（songjian.tianda.studio，
#   profile=test），不是生产 —— 拿它的输出冒充生产证据就是伪造。逐条 blocked 记录见
#   doc/ops/部署手册.md §12 与 SYS-PROD-001 的完工报告。
#
# ★ 取到真值后，acc1 / acc2 的完整跑法（含两处**需要人补一步**的地方）见本文件末尾「§ 怎么跑」。

# ── 1. 生产入口（acc1 第 1 段 / acc2 第 1 段都要用）─────────────────────────────────
# 生产站点根地址。**必须以 https:// 开头**（acc1 第 1 段的 `case "${BASE}" in https://*)` 就是查它；
# 小程序合法域名也只认 https）。
# 取法：生产域名 ICP 备案通过、DNS 解析到生产机、acme.sh 签出证书之后，形如
#       https://<生产域名>   —— 不带结尾斜杠、不带路径。
LQG_API_BASE=

# ── 2. 生产机 SSH（acc2 第 1 段的口径依据；SYS-BACKUP-001 也读它）──────────────────
# 形如 root@<生产主机>。取法：云控制台拿公网 IP + 部署时用的 SSH 用户/密钥。
# ★ 不要填 root@118.178.109.11 —— 那是测试机。
LQG_PROD_SSH=

# ── 3. 两个 client（与部署环境无关：就是 seed / baseline 里 sys_client 的两行）────────
# 取值与 doc/verify/verify.env(.example) 一致 —— 它们是**客户端标识**，不是密钥：
#   pc = 工作台账号密码登录；mp = 小程序 xcx 登录（client_id = md5('mp' || client_secret)，
#   取号依据见 doc/waves/reports/AUTH-LOGIN-001.md §1）。
# 取法：`select client_id, client_key from sys_client;`（生产库里），或直接沿用下面这两个值
# （baseline 迁移带过去的，条带一致）。
LQG_CLIENT_PC=e5cd7e4891bf95d1d19206ce24a7b32e
LQG_CLIENT_MP=22b2aecd0710671691ec1c07f2542b9d

# ── 4. 生产管理员（acc1 第 2 段用；★ 口令不进仓库）─────────────────────────────────
# **不是**测试环境的 lqgadmin/admin123，也**不是**上游默认的 admin/admin123：
# 上线后停用上游默认 admin（改成随机强口令并记进交接单），另建一个甲方管理员的手机号账号
# 并授权（部署手册 §9）。
# 取法：部署当天由 Kevin 在服务器上设定的那个账号 + 口令（只写进本地 verify.prod.env，600）。
# 生产管理员的**一次性 token**（SYS-PROD-001 acc1 用它直接打 /lqg/sys/ping，见 #311）：
#   生产开着验证码与接口加解密，doc/verify/api.sh 的裸 curl 登录进不去。
#   取法：在服务器上（或经跳板）打开工作台，用超管登录后从浏览器 localStorage 的 `Admin-Token` 复制。
#   过期就重取一次，不必改别的键。
LQG_ADMIN_TOKEN=
LQG_ADMIN_USER=
LQG_ADMIN_PASSWORD=

# ── 5. OSS 匿名读探针（acc2 第 4 段）──────────────────────────────────────────────
# 一个**真实存在**的对象裸地址（不带任何签名参数），例如
#   https://<bucket>.<endpoint>/lqg/<某个已上传的文件>
# 期望：匿名 GET 返回 **403**（私有桶）。
# 取法：往生产桶传一个文件（后端上传 或 ossutil cp），在控制台「文件管理」里复制它的**不带签名**
#       URL（别点「复制签名 URL」，那带 Expires/Signature，403 就变成 200 了，断言失去意义）。
# ⚠️ 这一条要 owner 提供的 RAM 子账号 AK（B1）；桶权限一旦是公共读，得到 200 → 红，且这是**真问题**。
LQG_OSS_PROBE_URL=

# ── 6. 告警 webhook（acc 本身不查它；运维要用）─────────────────────────────────────
# 飞书群自定义机器人 webhook。取法：飞书群 → 设置 → 群机器人 → 添加「自定义机器人」→ 复制地址。
LQG_ALERT_WEBHOOK=

# ── 7. 生产 OSS / 备份口径（SYS-BACKUP-001 会读；本票的 oss-init 阶段也读 .env 里的同源值）──
# 桶名 / endpoint / region / 前缀。取法与 code/deploy/prod/.env.example 的 LQG_OSS_* 同源。
# ★ 这里**不列 AK/SK**：AK 只进服务器上的 .env 与 sys_oss_config，绝不落到 verify 文件里
#   （accept 2 第 6 段就是 `git grep 'LTAI[0-9A-Za-z]{12,}'`，而 verify.prod.env 虽然被 gitignore，
#    但它会被人 sync 到各处 —— 少一份副本少一份泄漏面）。
LQG_OSS_BUCKET=
LQG_OSS_PREFIX=lqg/

# ══════════════════════════════════════════════════════════════════════════════════
# § 怎么跑（取到真值之后）
# ══════════════════════════════════════════════════════════════════════════════════
#
# acc1 的原样命令在 doc/tickets/SYS-PROD-001/prompt.md 的 front-matter 里。跑之前有**两处
# 现实偏差**必须先知道（都不是产品缺陷，是口径问题）：
#
#   ① `doc/verify/api.sh --as admin` 在生产**登录不了**：acc1 第 2 段的 ping 用它，
#      而生产已把 `api-decrypt.enabled` 打开（application.yml 的缺省 true，prod 没有关它，
#      .env.production 的 VITE_APP_ENCRYPT=true 与它同口径）—— api.sh 是裸 curl，不带
#      encrypt-key 头、不做 RSA/AES，登录必失败；且验证码在 prod 是开着的（captcha.enable
#      没有像 test 那样被关），裸 curl 也过不了。
#      → 要跑这条，需要一个「带加密 + 带验证码」的登录方式（或给 api.sh 加一条只在内网/白名单
#        放行的旁路，那是**另一张票**的事）。
#      → 本票不做这件事：先把口径记在这里，由调度方决定（收窄断言 / 加 api.sh 能力 / 用工作台登录）。
#
#   ② acc2 第 4 段 `URL="$(bash -c '... api.sh --as admin GET /lqg/home/recent' ...)"` 里那条
#      api.sh 调用只是「先预热一下」的写法（它的 stdout 被丢掉，URL 其实从文件里 sed 出来），
#      所以它失败不影响 LQG_OSS_PROBE_URL 的取值 —— 但按 `set -e` 的语境整体跑会中断。
#      → 逐段手工跑时，把那一句的 `api.sh` 部分跳过即可。
#
# 分段手工跑的推荐顺序（每条都留下输出）：
#   export LQG_VERIFY_ENV_FILE=doc/verify/verify.prod.env
#   BASE="$(sed -n 's/^LQG_API_BASE=//p' doc/verify/verify.prod.env)"
#   case "${BASE}" in https://*) echo "① https 前缀 OK" ;; *) echo "① 红" ;; esac
#   bash doc/verify/api.sh --as admin GET /lqg/sys/ping | jq .        # ← 见 ① 的偏差
#   HOST="$(printf '%s' "${BASE}" | sed -E 's#https://([^/:]+).*#\1#')"
#   echo | openssl s_client -servername "${HOST}" -connect "${HOST}:443" 2>/dev/null \
#     | openssl x509 -noout -enddate
#   curl -sI "http://${HOST}/" | grep -i location                        # 期望 https://
#   for p in 5432 6379 3000 8080; do nc -z -w 3 "${HOST}" "${p}" && echo "${p} 可达（红）" || echo "${p} 不可达（绿）"; done
#   curl -s -o /dev/null -w '%{http_code}\n' "$(sed -n 's/^LQG_OSS_PROBE_URL=//p' doc/verify/verify.prod.env)"   # 期望 403
