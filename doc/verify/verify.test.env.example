# SYS-STAGING-001 · 测试环境（songjian.tianda.studio）的验收环境变量模板
#
#   cp doc/verify/verify.test.env.example doc/verify/verify.test.env     # 真文件不进 git
#   export LQG_VERIFY_ENV_FILE=doc/verify/verify.test.env
#   bash doc/verify/api.sh --as admin GET /lqg/sys/ping
#
# ★ 与 verify.env（本地开发环境）的分工：
#   · verify.env        → DB 直连 127.0.0.1:5433 的开发库，**库类断言**（db.py）只在本地跑；
#   · verify.test.env   → 只给**接口类断言**用：测试机的 postgres/redis/minio 一律只绑 127.0.0.1，
#                         公网连不上（SYS-STAGING-001 accept 第 2 条要的正是这个），
#                         所以这里**没有也不许有** LQG_DB_* 的可用值。
# ★ LQG_API_BASE 必须是 **https://** 开头：小程序体验版只认 https 请求域名
#   （accept 第 1 条最后一段就查这个前缀）。
# ★ api.sh / reseed.sh 都按 `LQG_VERIFY_ENV_FILE` 选文件；不设它则默认读同目录的 verify.env。

# 测试环境入口：宿主宝塔 nginx 终止 TLS → 127.0.0.1:8083（compose 的 nginx）→ backend 容器
LQG_API_BASE=https://songjian.tianda.studio

# 两个 client（取值与 verify.env 一致：都是 seed 里 sys_client 的行，与部署环境无关）
#   pc = 工作台账号密码登录；mp = 小程序 xcx 登录（client_id = md5('mp' || client_secret)）
LQG_CLIENT_PC=e5cd7e4891bf95d1d19206ce24a7b32e
LQG_CLIENT_MP=22b2aecd0710671691ec1c07f2542b9d

# 工作台测试管理员（seed 里的 lqgadmin；口令只用于测试环境）
LQG_ADMIN_USER=lqgadmin
LQG_ADMIN_PASSWORD=admin123

# 不给 DB 连接：测试机的库只绑 127.0.0.1，公网连不上（这也是 accept 第 2 条要证的）。
# 想在测试机上做库类断言，就在测试机上跑——库连接写在 /opt/lqg-test/verify.env（600，不进 git）。
