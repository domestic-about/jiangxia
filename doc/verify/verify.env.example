# 复制成 verify.env（已在 .gitignore 里）。只许指向**开发 / 测试**库，绝不指向生产。
LQG_DB_HOST=127.0.0.1
LQG_DB_PORT=5432
LQG_DB_NAME=lqg_dev
LQG_DB_USER=lqg
LQG_DB_PASSWORD=
# 后端地址与两个 client（pc = 工作台账号密码登录；mp = 小程序 xcx 登录）。clientId 取 sys_client.client_id
LQG_API_BASE=http://127.0.0.1:8080
LQG_CLIENT_PC=e5cd7e4891bf95d1d19206ce24a7b32e
LQG_CLIENT_MP=
# 工作台测试管理员（seed.sql 里的 lqgadmin；口令只用于开发 / 测试环境）
LQG_ADMIN_USER=lqgadmin
LQG_ADMIN_PASSWORD=admin123
